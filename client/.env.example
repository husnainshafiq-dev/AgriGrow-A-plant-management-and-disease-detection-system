# Backend API URL (Render/Production backend URL for Vercel deployment)
# Leave empty in local development to use Vite's built-in proxy
VITE_API_URL="https://your-agrigrow-api.onrender.com"

VITE_GOOGLE_MAPS_API_KEY=""
