# ============================================================
# 🌾 AgriGrow — Environment Variables Template
# ============================================================
# Copy this file to .env in the respective service directories
# and fill in the actual values.
#
# NEVER commit real .env files to version control!
# ============================================================

# --- Server (Node.js + Express) ---
NODE_ENV=development
PORT=5000
MONGO_URI=mongodb://localhost:27017/agrigrow
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRE=7d

# --- Gemini AI ---
GEMINI_API_KEY=your_gemini_api_key_here

# --- ML Service ---
ML_SERVICE_URL=http://localhost:8000

# --- Client (React / Vite) ---
VITE_API_URL=http://localhost:5000/api
