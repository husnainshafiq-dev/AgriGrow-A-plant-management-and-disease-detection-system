      "auth_required": false,
      "roles": [],
      "components": ["FileUpload", "ImagePreview", "ResultDisplay", "ConfidenceBar", "AIAdvisory"],
      "links_to": ["/dashboard", "/login"],
      "forms": [
        {
          "name": "DiseaseDetectionForm",
          "fields": ["image", "farmId", "cropId"],
          "submit_action": "POST /api/disease/detect",
          "validations": {
            "image": "required, JPEG/PNG/WebP, max 10MB"
          }
        }
      ],
