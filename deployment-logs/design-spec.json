    },
    {
      "name": "Dashboard",
      "path": "/dashboard",
      "auth_required": true,
      "roles": ["farmer", "admin"],
      "components": ["FieldMapView", "WeatherWidget", "CropAdvisoryPanel", "SavedFieldsDrawer"],
      "links_to": ["/farm-map", "/"],
      "forms": [],
      "source": "docs/review.md"
    }
  ],
  "user_flows": [],
  "business_rules": [
    {
      "id": "BR-001",
      "description": "New users must register with name, email, and password. Default role is 'farmer'.",
      "category": "validation",
      "entities": ["User"],
      "endpoints": ["POST /api/auth/register"],
      "source": "docs/API_REFERENCE.md"
    },
    {
      "id": "BR-002",
      "description": "Users must authenticate with valid email and password to receive JWT token.",
      "category": "authorization",
      "entities": ["User"],
      "endpoints": ["POST /api/auth/login"],
      "source": "docs/API_REFERENCE.md"
    },
    {
      "id": "BR-003",
      "description": "After 5 failed login attempts, user account is locked for 30 minutes.",
      "category": "constraint",
      "entities": ["User"],
      "endpoints": ["POST /api/auth/login"],
      "source": "docs/DATABASE_DESIGN.md"
    },
    {
      "id": "BR-004",
      "description": "Disease detection accepts only image files (JPEG, PNG, WebP) up to 10MB.",
      "category": "validation",
      "entities": ["DiseaseReport"],
      "endpoints": ["POST /api/disease/detect"],
      "source": "docs/API_REFERENCE.md"
    },
    {
      "id": "BR-005",
      "description": "ML service must verify image file magic bytes (header) to prevent file spoofing.",
      "category": "validation",
      "entities": ["DiseaseReport"],
      "endpoints": ["POST /api/disease/detect"],
      "source": "docs/IMAGE_UPLOAD_ML_GUIDE.md"
    },
    {
      "id": "BR-006",
      "description": "Disease detection confidence levels: HIGH (>=85%), MODERATE (65-84%), LOW (50-64%), VERY LOW (<50%).",
      "category": "conditional",
      "entities": ["DiseaseReport"],
      "endpoints": ["POST /api/disease/detect"],
      "source": "docs/IMAGE_UPLOAD_ML_GUIDE.md"
    },
    {
      "id": "BR-007",
      "description": "AI advisory requests are rate-limited to 10 requests per minute per user.",
      "category": "constraint",
      "entities": ["Advisory"],
      "endpoints": ["POST /api/advisory/ask"],
      "source": "docs/GEMINI_AI_GUIDE.md"
    },
    {
      "id": "BR-008",
      "description": "If Gemini AI service is unavailable, system must provide fallback advisory from ML model's disease info database.",
      "category": "conditional",
      "entities": ["Advisory"],
      "endpoints": ["POST /api/advisory/ask", "POST /api/advisory/disease"],
      "source": "docs/GEMINI_AI_GUIDE.md"
    },
    {
      "id": "BR-009",
      "description": "Farm polygons must have at least 4 points (3 unique + 1 closing point).",
      "category": "validation",
      "entities": ["Farm"],
      "endpoints": ["POST /api/farms", "PUT /api/farms/:id"],
      "source": "docs/FARM_MAPPING_GUIDE.md"
    },
    {
      "id": "BR-010",
      "description": "Farm polygon coordinates must be in GeoJSON format with longitude before latitude.",
      "category": "validation",
      "entities": ["Farm"],
      "endpoints": ["POST /api/farms", "PUT /api/farms/:id"],
      "source": "docs/FARM_MAPPING_GUIDE.md"
    },
    {
      "id": "BR-011",
      "description": "Farm area must be between 10 m² minimum and 10,000 hectares maximum.",
      "category": "validation",
      "entities": ["Farm"],
      "endpoints": ["POST /api/farms", "PUT /api/farms/:id"],
      "source": "docs/FARM_MAPPING_GUIDE.md"
    },
    {
      "id": "BR-012",
      "description": "Cost estimation calculates total cost, expected yield, revenue, profit, and ROI based on crop and area.",
      "category": "conditional",
      "entities": ["CostEstimation"],
      "endpoints": ["POST /api/cost/estimate"],
      "source": "docs/API_REFERENCE.md"
    },
    {
      "id": "BR-013",
      "description": "CRITICAL: Users can register as admin by passing role='admin' in registration request. This is a privilege escalation vulnerability.",
      "category": "authorization",
      "entities": ["User"],
      "endpoints": ["POST /api/auth/register"],
      "source": "docs/review.md"
    },
    {
      "id": "BR-014",
      "description": "CRITICAL: Notification endpoint allows IDOR attack via email query parameter without authentication.",
      "category": "authorization",
      "entities": ["Notification"],
      "endpoints": ["GET /api/blog/notifications"],
      "source": "docs/review.md"
    },
    {
      "id": "BR-015",
      "description": "HIGH: Unauthenticated users can upload disease images that are saved to disk but never deleted, causing storage exhaustion.",
      "category": "constraint",
      "entities": ["DiseaseReport"],
      "endpoints": ["POST /api/disease/detect"],
      "source": "docs/review.md"
    }
  ],
  "state_machines": [
    {
      "entity": "Crop",
      "field": "status",
      "states": ["planned", "planted", "growing", "harvested", "failed"],
      "transitions": [
        { "from": "planned", "to": "planted", "trigger": "User marks crop as planted" },
        { "from": "planted", "to": "growing", "trigger": "User updates crop status after growth begins" },
        { "from": "growing", "to": "harvested", "trigger": "User records harvest date and yield" },
        { "from": "growing", "to": "failed", "trigger": "Crop fails due to disease or weather" },
        { "from": "planned", "to": "failed", "trigger": "Crop never planted and season ended" }
      ],
      "invalid_transitions": [
        { "from": "harvested", "to": "planted", "reason": "Cannot replant already harvested crop" },
        { "from": "failed", "to": "growing", "reason": "Failed crops cannot resume growth" }
      ],
      "source": "docs/DATABASE_DESIGN.md"
    }
  ]
}
